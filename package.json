{
  "name": "frasapp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "test:e2e": "turbo run test:e2e",
    "db:reset": "pnpm --filter @frasapp/padel-template db:reset",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:db && pnpm run build"
  },
  "devDependencies": {
    "turbo": "2.11.4",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["unrs-resolver"]
  }
}
