# Plantilla de variables de entorno. Este fichero se versiona, los valores NO.
# Copiar a .env.local y rellenar. .env.local esta en .gitignore.
#
# Son 9 variables de la aplicacion, y ademas 5 de herramientas locales al final.
# Si anades una, anadela tambien a la seccion 9 de
# docs/specs/padel-template-mvp.md y revisa que no expones un secreto al cliente.

# --- Supabase -------------------------------------------------------------
# Las dos NEXT_PUBLIC_* van al cliente y son publicas por diseño: la anon key
# solo sirve si RLS esta completa. Sin RLS, la anon key es una puerta abierta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA en el cliente: bypassa RLS por definicion.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---------------------------------------------------------------
# Solo servidor. El webhook se valida con STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comision de la plataforma, en porcentaje entero. 0 al lanzamiento (OQ-13).
# Con valor 0 el PaymentIntent NO debe llevar application_fee_amount.
STRIPE_PLATFORM_FEE_PERCENT=0

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=
# Dominio tecnico unico nuestro, compartido por todos los tenants (OQ-12).
# El nombre de remitente y el Reply-To se configuran por tenant en
# tenant_branding, no aqui.
EMAIL_FROM_DOMAIN=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# Slug del club al que pertenece ESTA instancia. Solo servidor, sin NEXT_PUBLIC_.
#
# El modelo es una instancia aislada por cliente, asi que el tenant no se deduce
# de la peticion: se fija al desplegar. Sin esta variable, `resolveTenantId()`
# falla, y los endpoints publicos devuelven 500 con un cuerpo generico en vez
# de un catalogo vacio (un [] aqui seria un despliegue roto disfrazado de club
# sin pistas).
#
# En local: el slug que crea `pnpm db:reset`, que es `club-padel-demo`.
# En produccion: el slug del cliente, en su propia instancia. Cambiarlo cambia
# el club entero, asi que va en el despliegue y no en un panel.
TENANT_SLUG=club-padel-demo

# --- Herramientas locales (NO son config de la app) ------------------------
# Las usa `pnpm db:reset` y `pnpm test:db` para hablar con el PostgreSQL nativo
# de desarrollo. En produccion la app NO lee ninguna de estas: connects a
# Supabase con las variables de arriba.
#
# Es la unica variable de todo el fichero que hay que rellenar de verdad para
# empezar: es la contraseña que elegiste al instalar PostgreSQL. Sin ella
# `db:reset` se para con un mensaje, en vez de adivinar.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Base que crea y puebla `pnpm db:reset`.
PGDATABASE=padel_template
# Base de mantenimiento, para poder hacer DROP DATABASE. Nunca se borra.
PGADMIN_DATABASE=postgres
