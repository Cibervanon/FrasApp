# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
.next/
out/
build/
*.tsbuildinfo

# Turbo
.turbo/

# Tests
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Entorno. Los secretos viven SOLO en .env.local, nunca en el repo.
.env
.env.local
.env.*.local
!.env.example

# Supabase
# El prefijo **/ es obligatorio: un patron con "/" interno se ancla a la raiz del
# repo, asi que "supabase/.temp/" no cubria apps/padel-template/supabase/.temp/
# y el ignore pasaba silenciosamente sin efecto.
**/supabase/.temp/
**/supabase/.branches/
**/supabase/.env

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Varios
*.log
npm-debug.log*
pnpm-debug.log*
.vercel
